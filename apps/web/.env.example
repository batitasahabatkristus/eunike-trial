# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Server only. Never import these in client code.
SUPABASE_SERVICE_ROLE_KEY=
COUNSELING_ENCRYPTION_KEY=
SENTRY_DSN=
# Local/preview only, fake data. Ignored (and refused) when VERCEL_ENV=production.
EUNIKE_DEV_AUTH=1
EUNIKE_DEV_AUTH_SECRET=change-me-local-only
# Postgres connection used for all app data (Supabase: the pooler string, transaction mode). Queries run as `authenticated` so RLS applies.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
CARD_QR_SECRET=
CRON_SECRET=

# Preview deployment marker (branch "preview" only): Vercel builds this as a Preview, where fake-persona login is allowed.
